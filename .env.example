# Core
DEBUG=true
SECRET_KEY=some-random-secret-key
ALLOWED_HOSTS=*

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# HTTPS (relaxed for local dev; enable when DEBUG=false in production)
SECURE_SSL_REDIRECT=false
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_BROWSER_XSS_FILTER=true
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Database / Redis
DATABASE_URL='postgresql://localhost:5432/dj-starter'
REDIS_URL='redis://localhost:6379'

# Session
SESSION_COOKIE_NAME=session-id
SESSION_COOKIE_AGE=2592000
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTPONLY=false
CSRF_COOKIE_SAMESITE=Lax

# OpenAPI
ENABLE_OPENAPI=true

# Storage
ACCESS_KEY_ID=some-random-access-key-id
SECRET_ACCESS_KEY=some-random-secret-access-key
STORAGE_BUCKET_NAME=some-random-storage-bucket-name
REGION_NAME=auto
ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional: public CDN domain for static files (leave empty to use signed endpoint URLs)
STATIC_STORAGE_CUSTOM_DOMAIN=

# Email
EMAIL_HOST=some-random-email-host
EMAIL_PORT=587
EMAIL_HOST_USER=some-random-email-host-user
EMAIL_HOST_PASSWORD=some-random-email-host-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
EMAIL_SUBJECT_PREFIX=[Django]
# Format: Name:email@example.com,Another Name:email2@example.com
ADMINS=
MANAGERS=

# File upload limits
FILE_UPLOAD_MAX_MEMORY_SIZE=15728640
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# Silk (local profiling only; ignored when DEBUG=false)
SILK_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Sentry (leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SAMPLE_RATE=1.0

# Gunicorn
GUNICORN_BIND=0.0.0.0:8000
WEB_CONCURRENCY=3
GUNICORN_LOGLEVEL=info
# Seconds without a worker heartbeat before it is killed and replaced
GUNICORN_TIMEOUT=60
